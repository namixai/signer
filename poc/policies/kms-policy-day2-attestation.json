{
  "Version": "2012-10-17",
  "Id": "signer-poc-day2-attestation",
  "Statement": [
    {
      "Sid": "EnableRootAdmin",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::194173164271:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AdminUserFullAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::194173164271:user/alex-admin"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "BuilderManagementOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::194173164271:user/signer-poc-builder"
      },
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:CreateAlias",
        "kms:UpdateAlias",
        "kms:ListAliases"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EnclaveAttestedDecryptOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::194173164271:role/signer-poc-enclave-role"
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "kms:RecipientAttestation:PCR0": "e306e6a4d00e4cbacb25dc0cab60bdb88b702ab14db854ef9e1b362b6a9f83fb624c423fb38d755454b541331e5732d7"
        }
      }
    },
    {
      "Sid": "DenyDirectDecryptWithoutAttestation",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "arn:aws:iam::194173164271:user/signer-poc-builder",
          "arn:aws:iam::194173164271:role/signer-poc-enclave-role"
        ]
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "Null": {
          "kms:RecipientAttestation:PCR0": "true"
        },
        "StringNotEqualsIfExists": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyDecryptWithWrongPCR0",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "arn:aws:iam::194173164271:user/signer-poc-builder",
          "arn:aws:iam::194173164271:role/signer-poc-enclave-role"
        ]
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "kms:RecipientAttestation:PCR0": "e306e6a4d00e4cbacb25dc0cab60bdb88b702ab14db854ef9e1b362b6a9f83fb624c423fb38d755454b541331e5732d7"
        },
        "Null": {
          "kms:RecipientAttestation:PCR0": "false"
        }
      }
    }
  ]
}
